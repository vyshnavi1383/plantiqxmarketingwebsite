# Dependencies — reinstalled inside the container
node_modules

# Build output — rebuilt inside the container
dist

# Version control
.git
.gitignore

# Editor / OS
.DS_Store
*.swp
*.swo
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment files (never bake secrets into the image)
.env
.env.*
!.env.example

# Docker files themselves (not needed in the image)
Dockerfile
docker-compose.yml
nginx.conf
